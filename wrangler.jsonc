// Cloudflare Workers + Containers config for the hosted hub. Runbook: docs/hosted-hub.md.
// Requires the Workers Paid plan ($5/month) and Docker Desktop. Deploy with: tools/deploy-hub.ps1
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meldmind-hub",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // the hub container: built from ./Dockerfile, one instance, smallest size (1/16 vCPU, 256 MiB)
  "containers": [
    { "class_name": "Hub", "image": "./Dockerfile", "max_instances": 1, "instance_type": "lite" }
  ],
  "durable_objects": { "bindings": [{ "class_name": "Hub", "name": "HUB" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],

  // Safety-net check every 15 minutes. It reads one stored time in the Durable Object and does NOT
  // start the container unless a schedule is due (worker/hub-clock.js). The real wake for a schedule
  // is a Durable Object alarm set for the exact minute it is due, so the container can sleep in between.
  // CC_TICK_SECRET is set with `npx wrangler secret put CC_TICK_SECRET` and is not stored here.
  // CC_METRICS_SECRET is set with `npx wrangler secret put CC_METRICS_SECRET` and is not stored here.
  "triggers": { "crons": ["*/15 * * * *"] },

  // ---- HUB ADDRESS: the route "pattern" and "CC_HUB_URL" below must name the same host. ----
  // Today: hub.everbornproductions.com (everbornproductions.com is a zone in the Cloudflare account,
  // so Cloudflare creates the DNS record and certificate on deploy).
  // Later, once meldmind.ai is added as a Cloudflare zone, change the two lines to:
  //   "routes": [{ "pattern": "hub.meldmind.ai", "custom_domain": true }, { "pattern": "hub.everbornproductions.com", "custom_domain": true }],
  //   "CC_HUB_URL": "https://hub.meldmind.ai",
  // (keeping the old host as a second route so installed apps that use it keep working), then set
  // DEFAULT_HUB_URL in server/hub-address.js and CC_HUB_URL in fly.toml to the same address.
  "routes": [{ "pattern": "hub.everbornproductions.com", "custom_domain": true }],

  // non-secret settings (secrets go in with `wrangler secret put NAME`, never in this file)
  "vars": {
    "CC_HUB_URL": "https://hub.everbornproductions.com",
    "CC_SUPABASE_URL": "https://ezbpstloczzdlcxwliwu.supabase.co",
    "CC_OWNER_EMAILS": "everbornproductions@gmail.com"
  }
}
