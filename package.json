{
  "name": "everborn-command-center",
  "version": "0.4.0",
  "description": "Command AI, an Everborn product: one console for every AI you pay for. Council, missions, credits, projects.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "electron": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "node test/smoke.mjs"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "electron-updater": "^6.8.9",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "author": "Everborn Productions <everbornproductions@gmail.com>",
  "homepage": "https://everbornproductions.com/command-center/"
}
